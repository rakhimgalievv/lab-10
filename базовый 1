<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Конвертер температур — Lab 10</title>
  <link rel="stylesheet" href="./styles/style.css">
</head>
<body>
  <main class="container">
    <p class="eyebrow">Лабораторная работа №10 · Базовый уровень · Вариант 1</p>
    <h1>Конвертер температур</h1>
    <p class="muted">Перевод между градусами Цельсия, Фаренгейта и Кельвина.</p>
    <form id="converter-form" class="panel">
      <label for="temperature">Температура</label>
      <input id="temperature" type="number" step="any" placeholder="Например, 25" required>
      <div class="fields">
        <label>Из
          <select id="from-unit">
            <option value="C">Цельсий (°C)</option>
            <option value="F">Фаренгейт (°F)</option>
            <option value="K">Кельвин (K)</option>
          </select>
        </label>
        <label>В
          <select id="to-unit">
            <option value="F">Фаренгейт (°F)</option>
            <option value="C">Цельсий (°C)</option>
            <option value="K">Кельвин (K)</option>
          </select>
        </label>
      </div>
      <button type="submit">Конвертировать</button>
      <p id="result" class="result" aria-live="polite">Результат появится здесь</p>
      <p id="error" class="error" aria-live="polite"></p>
    </form>
    <p class="footnote">Подсказка: температура в Кельвинах не может быть ниже 0 K.</p>
  </main>
  <script type="module" src="./src/main.js"></script>
</body>
</html>
